# ==============================================================================
# survey-data-pipeline environment configuration
# Copy to .env: `cp .env.example .env`
# ==============================================================================

# MongoDB Configuration (Raw Landing Zone / Data Lake)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=survey_admin
MONGO_PASSWORD=survey_secret_pass
MONGO_DB=survey_raw_lake
MONGO_AUTH_SOURCE=admin

# PostgreSQL Configuration (Staging, Warehouse, Analytics, Audit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=survey_engineer
POSTGRES_PASSWORD=survey_pg_pass
POSTGRES_DB=survey_dw

# Pipeline Settings
PIPELINE_ENV=development
LOG_LEVEL=INFO
BATCH_ID=auto
DATA_DIR=data
FUZZY_MATCH_THRESHOLD=85.0
OUTLIER_IQR_FACTOR=1.5

# Web UI Ports (Optional Docker inspection tools)
MONGO_EXPRESS_PORT=8081
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@surveyanalytics.com
PGADMIN_DEFAULT_PASSWORD=admin
